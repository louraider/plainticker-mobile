# redaction-denylist.sha256 — read by scripts/redaction-guard.sh
#
# One entry per line: the SHA-256 (64 hex chars) of a base58 identifier that must never
# appear in this repository, optionally followed by a label. The identifier itself goes
# NOWHERE in the repo, not even in this file; only its hash does.
#
#   printf %s '<identifier>' | sha256sum | cut -d' ' -f1
#
# Lines starting with '#' are ignored. The guard fails if an active line is not a hex digest.
2246dcff0edadcf67df1c2dc870c1c8cfc52747f46cca06a0dbd1cc8f8e2ca1b  founder wallet public key
44ccc5ca952d8ba1b8ea09760dd5be61ac2cd219c40f5942ddf0812a349f55f5  transaction signature of the Sep 10 spike swap
165286d8c03f3a00b15760d19bf4e7fb072cc52858742277271b4ebfc2bc5729  founder SKR stake account
