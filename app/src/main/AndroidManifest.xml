<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Runtime on this phone's API level, and asked for exactly once: at the moment the first
         ticker is watched, never at launch (plan section 13 Pass 2 and Pass 7). A refusal costs
         the notification and nothing else; the digest is on the Watchlist screen either way. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The optional app lock (You, Security; lock/BiometricAuthenticator.kt): off by default, and
         when on, PlainTicker asks for the fingerprint or the screen lock when it opens. USE_BIOMETRIC
         is what androidx.biometric's BiometricPrompt needs; USE_FINGERPRINT is the same prompt's
         permission on Android 8 and 9, where it draws through FingerprintManager. Neither signs
         anything: the Seed Vault still signs every transaction. Declared here rather than left to
         arrive with a library, so the dApp Store review (PER-001) can see what each one is for. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- Merged in from androidx.test for instrumented tests, never used by the app: removed so the
         release does not ask for it. -->
    <uses-permission android:name="android.permission.REORDER_TASKS" tools:node="remove" />

    <application
        android:name=".PlainTickerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PlainTicker">
        <!-- Portrait only (plan section 13 Pass 6): a rotation during the wallet round trip must
             never recreate the Activity, so the size changes a rotation, a fold or a multi-window
             resize can still raise are handled in place, and so is a day/night flip (the theme is
             dark only). Compose re-reads the configuration itself.
             adjustResize (device QA of 1.3.17): the default panned the whole window up behind the
             keyboard, which took the status-bar scrim off screen, ran text under the clock and hid
             "No xStock matches" behind the keys. Compose now lays out above the keyboard itself
             (HomeScreen's imePadding). -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.PlainTicker.Starting"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="LockedOrientationActivity,DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The share image (ui/share/ShareImage.kt): a PNG in cache/share/ handed to the app the
             reader picks as a content:// URI with a one-off read grant. Not exported, one folder
             (res/xml/share_paths.xml). ShareProviderTest pins all three. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
    </application>

</manifest>
