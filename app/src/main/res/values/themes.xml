<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark only (this window; the live Compose content is AmberTheme and follows the system
         setting). The window paints Amber's own dark ground so no mismatched frame flashes before
         Compose draws, and both system bars are transparent from the first frame;
         MainActivity.enableEdgeToEdge then lays the content out under them with light icons.
         amber_ground replaces Instrument's retired, cool "canvas": see colors.xml and DESIGN.md
         section 9. -->
    <style name="Theme.PlainTicker" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/amber_ground</item>
        <item name="android:colorBackground">@color/amber_ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash, DESIGN.md section 9: Amber's own ground behind the brand mark, no branding image.
         core-splashscreen draws it on every release the app runs on; MainActivity.installSplashScreen
         then switches to Theme.PlainTicker.
         The icon here is ic_brand_mark and not the adaptive icon's foreground layer. They are the
         same four rectangles, but the foreground is drawn in amber_ground for the amber_action tile
         the launcher shows (DESIGN.md section 9, "Two corners, refit"), and amber_ground on
         amber_ground is nothing at all. glyph.py writes both from the same geometry so they cannot
         drift apart.
         Theme.SplashScreen is a DayNight theme, so on a light system theme it would ask for dark
         status and navigation bar icons over the near-black amber_ground; both flags are pinned to
         light icons here. windowLightNavigationBar exists from API 27 and is ignored on 26. -->
    <style name="Theme.PlainTicker.Starting" parent="Theme.SplashScreen" tools:targetApi="27">
        <item name="windowSplashScreenBackground">@color/amber_ground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_brand_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.PlainTicker</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
